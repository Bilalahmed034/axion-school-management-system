# Database Configuration
MONGO_URI=mongodb://localhost:27017/school_management_db # add your mongo uri here

# Redis Configuration (using default local for development)
CACHE_PREFIX=school_mgmt_
CACHE_REDIS=redis://localhost:6379
CORTEX_PREFIX=school_mgmt_
CORTEX_REDIS=redis://localhost:6379
CORTEX_TYPE=school_management_api

# JWT Configuration
LONG_TOKEN_SECRET=school_management_long_secret_2024
SHORT_TOKEN_SECRET=school_management_short_secret_2024
JWT_SECRET=school_management_secret_2024
TOKEN_EXPIRY=24h

# Server Configuration
PORT=3000
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
# API Configuration
API_VERSION=v1
BASE_URL=http://localhost:3000/api
